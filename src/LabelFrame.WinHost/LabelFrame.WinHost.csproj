<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>..\..\assets\labelframe.ico</ApplicationIcon>
    <TargetFramework>net10.0-windows10.0.26100</TargetFramework>
    <RootNamespace>LabelFrame.WinHost</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Zebra 官方 Link-OS SDK：USB / TCP / 驱动 / 蓝牙 统一连接与打印机状态 -->
    <PackageReference Include="TemplateFrame.Excel.Simple" Version="1.0.5" />
    <PackageReference Include="Zebra.Printer.SDK" Version="3.0.3355" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LabelFrame.Core\LabelFrame.Core.csproj" />
    <ProjectReference Include="..\LabelFrame.Rendering\LabelFrame.Rendering.csproj" />
  </ItemGroup>

</Project>