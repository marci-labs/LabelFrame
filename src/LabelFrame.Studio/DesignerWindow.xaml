<Window x:Class="LabelFrame.Studio.DesignerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LabelFrame Studio - 模板设计器"
        Height="820" Width="1320"
        WindowStartupLocation="CenterOwner">
    <DockPanel>
        <!-- 顶栏 -->
        <Border DockPanel.Dock="Top" BorderBrush="#DDD" BorderThickness="0,0,0,1" Padding="8">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="模板名:" VerticalAlignment="Center"/>
                    <TextBox Width="150" Margin="4,0" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="分组:" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    <TextBox Width="110" Margin="4,0" Text="{Binding Group, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="宽(mm):" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    <TextBox Width="50" Margin="4,0" Text="{Binding WidthMm, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="高(mm):" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    <TextBox Width="50" Margin="4,0" Text="{Binding HeightMm, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="缩放:" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    <Slider Width="120" Minimum="0.5" Maximum="3" Value="{Binding Zoom}"/>
                    <TextBlock FontWeight="Bold" FontSize="14" Margin="14,0,0,0" Foreground="#0B5">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="标签尺寸：{0:F0} × {1:F0} mm">
                                <Binding Path="WidthMm"/>
                                <Binding Path="HeightMm"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <RadioButton x:Name="SelectTool" Content="选择 / 移动" IsChecked="True" VerticalAlignment="Center"/>
                    <RadioButton x:Name="RegionTool" Content="画区域（拖矩形）" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock Text="网格：" VerticalAlignment="Center" Margin="24,0,0,0"/>
                    <CheckBox x:Name="GridCheck" IsChecked="True" VerticalAlignment="Center"/>
                    <Button Content="保存" Width="70" Margin="28,0,0,0" Click="Save_Click"/>
                    <Button Content="打印测试" Width="90" Margin="6,0,0,0" FontWeight="Bold" Click="PrintTest_Click"/>
                    <Button Content="完成" Width="70" Margin="6,0,0,0" Click="Done_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 左侧：控件栏 + 字段 -->
        <Border DockPanel.Dock="Left" Width="300" BorderBrush="#DDD" BorderThickness="0,0,1,0" Padding="6">
            <DockPanel>
                <GroupBox DockPanel.Dock="Top" Header="控件栏（点按添加 / 拖入画布）" Margin="0,0,0,6">
                    <WrapPanel>
                        <Button Content="文本" Width="70" Margin="2" Click="AddElement_Click" Tag="Text" PreviewMouseMove="ElementButton_PreviewMouseMove"/>
                        <Button Content="条码" Width="70" Margin="2" Click="AddElement_Click" Tag="Barcode" PreviewMouseMove="ElementButton_PreviewMouseMove"/>
                        <Button Content="二维码" Width="70" Margin="2" Click="AddElement_Click" Tag="QrCode" PreviewMouseMove="ElementButton_PreviewMouseMove"/>
                        <Button Content="图片" Width="70" Margin="2" Click="AddElement_Click" Tag="Image" PreviewMouseMove="ElementButton_PreviewMouseMove"/>
                        <Button Content="线" Width="70" Margin="2" Click="AddElement_Click" Tag="Line" PreviewMouseMove="ElementButton_PreviewMouseMove"/>
                        <Button Content="区域" Width="70" Margin="2" Click="AddElement_Click" Tag="Region" PreviewMouseMove="ElementButton_PreviewMouseMove"/>
                    </WrapPanel>
                </GroupBox>

                <GroupBox Header="契约字段" Margin="0,0,0,6">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,4,0,0">
                            <Button Content="＋ 字段" Width="70" Click="AddField_Click"/>
                            <Button Content="－ 字段" Width="70" Margin="4,0" Click="RemoveField_Click"/>
                        </StackPanel>
                        <ListBox x:Name="FieldList" Height="130" ItemsSource="{Binding Fields}"
                                 SelectedItem="{Binding SelectedField}" SelectionChanged="FieldList_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <CheckBox IsChecked="{Binding IsRequired}" ToolTip="必填"/>
                                        <TextBlock Text="{Binding Key}" Width="90"/>
                                        <TextBlock Text="{Binding DisplayName}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel DataContext="{Binding SelectedField}" Margin="0,6,0,0">
                            <TextBlock Text="键 Key（改后元素引用自动跟随）" FontSize="11" Foreground="#666"/>
                            <TextBox x:Name="FieldKeyBox" Margin="0,2,0,4"
                                     Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}" LostFocus="FieldKey_LostFocus"/>
                            <TextBlock Text="显示名" FontSize="11" Foreground="#666"/>
                            <TextBox Margin="0,2,0,4" Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"/>
                            <StackPanel Orientation="Horizontal">
                                <CheckBox Content="必填" IsChecked="{Binding IsRequired}" VerticalAlignment="Center"/>
                                <ComboBox Margin="8,0,0,0" Width="90" ItemsSource="{Binding AvailableTypes}"
                                          SelectedItem="{Binding Type}"/>
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                </GroupBox>
            </DockPanel>
        </Border>

        <!-- 右侧：属性 + 测试数据 + 打印预览 -->
        <Border DockPanel.Dock="Right" Width="360" BorderBrush="#DDD" BorderThickness="1,0,0,0" Padding="6">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <GroupBox Header="属性（选中元素）">
                        <ContentControl Content="{Binding SelectedElement}">
                            <ContentControl.ContentTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding DisplayLabel}" FontWeight="Bold" Margin="0,0,0,6"/>
                                        <Expander Header="位置 / 尺寸" IsExpanded="True">
                                            <StackPanel>
                                                <TextBlock Text="X (mm)"/><TextBox Text="{Binding XMm, UpdateSourceTrigger=PropertyChanged}"/>
                                                <TextBlock Text="Y (mm)"/><TextBox Text="{Binding YMm, UpdateSourceTrigger=PropertyChanged}"/>
                                                <StackPanel Visibility="{Binding IsRect}">
                                                    <TextBlock Text="宽 (mm)"/><TextBox Text="{Binding WidthMm, UpdateSourceTrigger=PropertyChanged}"/>
                                                    <TextBlock Text="高 (mm)"/><TextBox Text="{Binding HeightMm, UpdateSourceTrigger=PropertyChanged}"/>
                                                </StackPanel>
                                                <StackPanel Visibility="{Binding IsText}">
                                                    <TextBlock Text="块宽 (mm，0=不限制)"/><TextBox Text="{Binding WidthMm, UpdateSourceTrigger=PropertyChanged}"/>
                                                </StackPanel>
                                                <StackPanel Visibility="{Binding IsLine}">
                                                    <TextBlock Text="终点 X2 (mm)"/><TextBox Text="{Binding X2Mm, UpdateSourceTrigger=PropertyChanged}"/>
                                                    <TextBlock Text="终点 Y2 (mm)"/><TextBox Text="{Binding Y2Mm, UpdateSourceTrigger=PropertyChanged}"/>
                                                    <TextBlock Text="线宽 (mm)"/><TextBox Text="{Binding ThicknessMm, UpdateSourceTrigger=PropertyChanged}"/>
                                                </StackPanel>
                                                <StackPanel Visibility="{Binding IsRegion}">
                                                    <TextBlock Text="区域 Id"/><TextBox Text="{Binding Id, UpdateSourceTrigger=PropertyChanged}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Expander>
                                        <Expander Header="文本 / 字体" IsExpanded="False">
                                            <StackPanel Visibility="{Binding IsText}">
                                                <TextBlock Text="字高 (mm)"/><TextBox Text="{Binding FontHeightMm, UpdateSourceTrigger=PropertyChanged}"/>
                                                <TextBlock Text="字宽 (mm)"/><TextBox Text="{Binding FontWidthMm, UpdateSourceTrigger=PropertyChanged}"/>
                                                <TextBlock Text="文字对齐"/>
                                                <ComboBox ItemsSource="{Binding TextAlignOptions}" SelectedItem="{Binding TextAlign}"/>
                                            </StackPanel>
                                        </Expander>
                                        <Expander Header="填充（内容来源）" IsExpanded="True">
                                            <StackPanel>
                                                <ComboBox ItemsSource="{Binding ContentModeOptions}" SelectedItem="{Binding ContentMode}"/>
                                                <TextBlock Text="固定值" FontSize="11" Foreground="#666" Margin="0,6,0,0"
                                                           Visibility="{Binding IsLiteral}"/>
                                                <TextBox Text="{Binding Literal, UpdateSourceTrigger=PropertyChanged}"
                                                         Visibility="{Binding IsLiteral}"/>
                                                <TextBlock Text="字段键 Key" FontSize="11" Foreground="#666" Margin="0,6,0,0"
                                                           Visibility="{Binding IsField}"/>
                                                <TextBox Text="{Binding SourceKey, UpdateSourceTrigger=PropertyChanged}"
                                                         Visibility="{Binding IsField}"/>
                                            </StackPanel>
                                        </Expander>
                                        <Expander Header="内边距 / 边框" IsExpanded="False">
                                            <StackPanel>
                                                <StackPanel Visibility="{Binding IsText}">
                                                    <TextBlock Text="内边距 Padding (mm)"/><TextBox Text="{Binding PaddingMm, UpdateSourceTrigger=PropertyChanged}"/>
                                                </StackPanel>
                                                <TextBlock Text="边框 Border (mm，0=无)" Margin="0,6,0,0"/>
                                                <TextBox Text="{Binding BorderMm, UpdateSourceTrigger=PropertyChanged}"/>
                                            </StackPanel>
                                        </Expander>
                                        <Expander Header="区域锚定" IsExpanded="False">
                                            <StackPanel>
                                                <TextBlock Text="所在区域 RegionId（空=绝对定位）" FontSize="11" Foreground="#666"/>
                                                <ComboBox ItemsSource="{Binding DataContext.RegionIds, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          SelectedItem="{Binding RegionId}"/>
                                                <TextBlock Text="区域内水平对齐" Margin="0,4,0,0"/>
                                                <ComboBox ItemsSource="{Binding RegionAlignOptions}" SelectedItem="{Binding RegionHAlign}"/>
                                                <TextBlock Text="区域内垂直对齐" Margin="0,4,0,0"/>
                                                <ComboBox ItemsSource="{Binding RegionAlignOptions}" SelectedItem="{Binding RegionVAlign}"/>
                                                <TextBlock Text="提示：选择工具下把元素拖进格子可自动锚定居中。" FontSize="11" Foreground="#888" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                            </StackPanel>
                                        </Expander>
                                    </StackPanel>
                                </DataTemplate>
                            </ContentControl.ContentTemplate>
                        </ContentControl>
                    </GroupBox>

                    <GroupBox Header="测试数据（打印测试用）" Margin="0,8,0,0">
                        <ItemsControl ItemsSource="{Binding TestFields}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" Margin="6,0,0,0"
                                                 Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </GroupBox>

                    <GroupBox Header="打印预览（实时）" Margin="0,8,0,0">
                        <Image x:Name="PreviewImage" Stretch="Uniform" MaxWidth="330" MaxHeight="300" Margin="4"/>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- 中间：画布 -->
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="10">
                <Border BorderBrush="#CCC" BorderThickness="1" Background="White"
                        Width="{Binding CanvasWidthPx}" Height="{Binding CanvasHeightPx}"
                        HorizontalAlignment="Left">
                    <Canvas x:Name="EditorCanvas" Background="{Binding CanvasBackground}"
                            Width="{Binding CanvasWidthPx}" Height="{Binding CanvasHeightPx}"
                            AllowDrop="True"
                            PreviewMouseLeftButtonDown="Canvas_MouseDown"
                            PreviewMouseMove="Canvas_MouseMove"
                            PreviewMouseLeftButtonUp="Canvas_MouseUp"
                            DragOver="Canvas_DragOver"
                            Drop="Canvas_Drop"/>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- 底部：状态 + 日志 -->
        <Border DockPanel.Dock="Bottom" BorderBrush="#DDD" BorderThickness="0,1,0,0" Padding="6" Height="140">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="{Binding StatusText}" Margin="0,0,0,4" FontWeight="Bold"/>
                <GroupBox Header="日志">
                    <ListBox ItemsSource="{Binding Logs}" FontFamily="Consolas" FontSize="11"/>
                </GroupBox>
            </DockPanel>
        </Border>
    </DockPanel>
</Window>