<Window x:Class="LabelFrame.Studio.DesignerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LabelFrame Studio - 模板设计器"
        Height="840" Width="1380"
        WindowStartupLocation="CenterOwner"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>
    <DockPanel>
        <!-- 顶栏 -->
        <Border DockPanel.Dock="Top" BorderBrush="#DDD" BorderThickness="0,0,0,1" Padding="8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="模板名:" VerticalAlignment="Center"/>
                <TextBox Width="140" Margin="4,0" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="分组:" VerticalAlignment="Center" Margin="12,0,0,0"/>
                <TextBox Width="90" Margin="4,0" Text="{Binding Group, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="宽(mm):" VerticalAlignment="Center" Margin="12,0,0,0"/>
                <TextBox Width="42" Margin="4,0" Text="{Binding WidthMm, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="高(mm):" VerticalAlignment="Center" Margin="8,0,0,0"/>
                <TextBox Width="42" Margin="4,0" Text="{Binding HeightMm, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="缩放:" VerticalAlignment="Center" Margin="14,0,0,0"/>
                <Slider Width="110" Minimum="0.25" Maximum="4" Value="{Binding Zoom}"/>
                <TextBlock Width="44" Margin="4,0" Text="{Binding Zoom, StringFormat={}{0:P0}}" VerticalAlignment="Center"/>
                <CheckBox x:Name="GridCheck" Content="网格" IsChecked="{Binding ShowGrid}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                <Button Content="保存" Width="64" Margin="22,0,0,0" Click="Save_Click"/>
                <Button Content="完成" Width="64" Margin="6,0,0,0" Click="Done_Click"/>
            </StackPanel>
        </Border>

        <!-- 左侧：控件栏 + 只读字段 -->
        <Border DockPanel.Dock="Left" Width="252" BorderBrush="#DDD" BorderThickness="0,0,1,0" Padding="6">
            <DockPanel>
                <GroupBox DockPanel.Dock="Top" Header="控件栏（点击添加 / 拖入画布）" Margin="0,0,0,6">
                    <WrapPanel>
                        <Border x:Name="PaletteText" Tag="Text" Width="68" Height="30" Margin="2" Background="#EFF4FB"
                                BorderBrush="#9BB7D4" BorderThickness="1" CornerRadius="3" Cursor="Hand"
                                MouseLeftButtonDown="Palette_MouseDown" PreviewMouseMove="Palette_PreviewMouseMove" MouseLeftButtonUp="Palette_MouseUp">
                            <TextBlock Text="文本" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border x:Name="PaletteBarcode" Tag="Barcode" Width="68" Height="30" Margin="2" Background="#EFF4FB"
                                BorderBrush="#9BB7D4" BorderThickness="1" CornerRadius="3" Cursor="Hand"
                                MouseLeftButtonDown="Palette_MouseDown" PreviewMouseMove="Palette_PreviewMouseMove" MouseLeftButtonUp="Palette_MouseUp">
                            <TextBlock Text="条码" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border x:Name="PaletteQrCode" Tag="QrCode" Width="68" Height="30" Margin="2" Background="#EFF4FB"
                                BorderBrush="#9BB7D4" BorderThickness="1" CornerRadius="3" Cursor="Hand"
                                MouseLeftButtonDown="Palette_MouseDown" PreviewMouseMove="Palette_PreviewMouseMove" MouseLeftButtonUp="Palette_MouseUp">
                            <TextBlock Text="二维码" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border x:Name="PaletteImage" Tag="Image" Width="68" Height="30" Margin="2" Background="#EFF4FB"
                                BorderBrush="#9BB7D4" BorderThickness="1" CornerRadius="3" Cursor="Hand"
                                MouseLeftButtonDown="Palette_MouseDown" PreviewMouseMove="Palette_PreviewMouseMove" MouseLeftButtonUp="Palette_MouseUp">
                            <TextBlock Text="图片" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border x:Name="PaletteLine" Tag="Line" Width="68" Height="30" Margin="2" Background="#EFF4FB"
                                BorderBrush="#9BB7D4" BorderThickness="1" CornerRadius="3" Cursor="Hand"
                                MouseLeftButtonDown="Palette_MouseDown" PreviewMouseMove="Palette_PreviewMouseMove" MouseLeftButtonUp="Palette_MouseUp">
                            <TextBlock Text="线" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border x:Name="PaletteRegion" Tag="Region" Width="68" Height="30" Margin="2" Background="#FFF4E0"
                                BorderBrush="#D4A75B" BorderThickness="1" CornerRadius="3" Cursor="Hand"
                                MouseLeftButtonDown="Palette_MouseDown" PreviewMouseMove="Palette_PreviewMouseMove" MouseLeftButtonUp="Palette_MouseUp">
                            <TextBlock Text="容器" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </WrapPanel>
                </GroupBox>

                <GroupBox Header="契约字段（由版式自动推导）">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" FontSize="11" Foreground="#888" TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="绑定元素填充的字段键会自动出现；删除引用后自动移除。"/>
                        <ListBox ItemsSource="{Binding Fields}" Height="180">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Key}" FontWeight="Bold" Width="120"/>
                                        <TextBlock Text="必填" Foreground="#C00" Visibility="{Binding IsRequired, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </GroupBox>
            </DockPanel>
        </Border>

        <!-- 右侧：属性面板（选中才显示） -->
        <Border DockPanel.Dock="Right" Width="344" BorderBrush="#DDD" BorderThickness="1,0,0,0" Padding="6">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasSelection}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <DockPanel Margin="0,0,0,6">
                        <TextBlock Text="{Binding SelectionCountText}" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Button DockPanel.Dock="Right" Content="删除" Width="64" Click="Delete_Click"/>
                    </DockPanel>

                    <!-- 多选：对齐工具 -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowMultiSelectionPanel}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <GroupBox Header="对齐（多选）">
                            <StackPanel>
                                <WrapPanel>
                                    <Button Content="左对齐" Tag="Left" Width="62" Margin="2" Click="Align_Click"/>
                                    <Button Content="水平居中" Tag="CenterH" Width="70" Margin="2" Click="Align_Click"/>
                                    <Button Content="右对齐" Tag="Right" Width="62" Margin="2" Click="Align_Click"/>
                                    <Button Content="上对齐" Tag="Top" Width="62" Margin="2" Click="Align_Click"/>
                                    <Button Content="垂直居中" Tag="CenterV" Width="70" Margin="2" Click="Align_Click"/>
                                    <Button Content="下对齐" Tag="Bottom" Width="62" Margin="2" Click="Align_Click"/>
                                </WrapPanel>
                                <TextBlock Text="提示：拖拽移动时边缘 / 中心会自动吸附到画布与其它元素。" FontSize="11" Foreground="#888" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>

                    <!-- 单选：元素属性 -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSingleSelection}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <ContentControl Content="{Binding SelectedElement}">
                            <ContentControl.ContentTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding DisplayLabel}" FontWeight="Bold" Margin="0,0,0,6"/>
                                        <Expander Header="位置 / 尺寸" IsExpanded="True">
                                            <StackPanel>
                                                <TextBlock Text="X (mm)"/><TextBox Text="{Binding XMm, UpdateSourceTrigger=PropertyChanged}"/>
                                                <TextBlock Text="Y (mm)"/><TextBox Text="{Binding YMm, UpdateSourceTrigger=PropertyChanged}"/>
                                                <StackPanel Visibility="{Binding IsRect}">
                                                    <TextBlock Text="宽 (mm)"/><TextBox Text="{Binding WidthMm, UpdateSourceTrigger=PropertyChanged}"/>
                                                    <TextBlock Text="高 (mm)"/><TextBox Text="{Binding HeightMm, UpdateSourceTrigger=PropertyChanged}"/>
                                                </StackPanel>
                                                <StackPanel Visibility="{Binding IsText}">
                                                    <TextBlock Text="块宽 (mm，0=不限制)"/><TextBox Text="{Binding WidthMm, UpdateSourceTrigger=PropertyChanged}"/>
                                                </StackPanel>
                                                <StackPanel Visibility="{Binding IsContainer}">
                                                    <TextBlock Text="容器标识 (Id)"/><TextBox Text="{Binding Id}" IsReadOnly="True"/>
                                                    <TextBlock Text="宽 (mm)"/><TextBox Text="{Binding WidthMm, UpdateSourceTrigger=PropertyChanged}"/>
                                                    <TextBlock Text="高 (mm)"/><TextBox Text="{Binding HeightMm, UpdateSourceTrigger=PropertyChanged}"/>
                                                </StackPanel>
                                                <StackPanel Visibility="{Binding IsLine}">
                                                    <TextBlock Text="终点 X2 (mm)"/><TextBox Text="{Binding X2Mm, UpdateSourceTrigger=PropertyChanged}"/>
                                                    <TextBlock Text="终点 Y2 (mm)"/><TextBox Text="{Binding Y2Mm, UpdateSourceTrigger=PropertyChanged}"/>
                                                    <TextBlock Text="线宽 (mm)"/><TextBox Text="{Binding ThicknessMm, UpdateSourceTrigger=PropertyChanged}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Expander>
                                        <Expander Header="文本 / 字体" IsExpanded="False">
                                            <StackPanel Visibility="{Binding IsText}">
                                                <TextBlock Text="字高 (mm)"/><TextBox Text="{Binding FontHeightMm, UpdateSourceTrigger=PropertyChanged}"/>
                                                <TextBlock Text="字宽 (mm)"/><TextBox Text="{Binding FontWidthMm, UpdateSourceTrigger=PropertyChanged}"/>
                                                <TextBlock Text="文字对齐"/>
                                                <ComboBox ItemsSource="{Binding TextAlignOptions}" SelectedItem="{Binding TextAlign}"/>
                                            </StackPanel>
                                        </Expander>
                                        <Expander Header="填充（内容来源）" IsExpanded="True">
                                            <StackPanel>
                                                <ComboBox ItemsSource="{Binding ContentModeOptions}" SelectedItem="{Binding ContentMode}"/>
                                                <TextBlock Text="固定值" FontSize="11" Foreground="#666" Margin="0,6,0,0"
                                                           Visibility="{Binding IsLiteral}"/>
                                                <TextBox Text="{Binding Literal, UpdateSourceTrigger=PropertyChanged}"
                                                         Visibility="{Binding IsLiteral}"/>
                                                <TextBlock Text="字段键 Key（可输入新键，字段自动建立）" FontSize="11" Foreground="#666" Margin="0,6,0,0"
                                                           Visibility="{Binding IsField}"/>
                                                <ComboBox IsEditable="True" IsTextSearchEnabled="True"
                                                          ItemsSource="{Binding DataContext.FieldKeys, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          Text="{Binding SourceKey, UpdateSourceTrigger=PropertyChanged}"
                                                          Visibility="{Binding IsField}"/>
                                            </StackPanel>
                                        </Expander>
                                        <Expander Header="内边距 / 边框" IsExpanded="False">
                                            <StackPanel>
                                                <StackPanel Visibility="{Binding IsText}">
                                                    <TextBlock Text="内边距 Padding (mm)"/><TextBox Text="{Binding PaddingMm, UpdateSourceTrigger=PropertyChanged}"/>
                                                </StackPanel>
                                                <TextBlock Text="边框 Border (mm，0=无)" Margin="0,6,0,0"/>
                                                <TextBox Text="{Binding BorderMm, UpdateSourceTrigger=PropertyChanged}"/>
                                            </StackPanel>
                                        </Expander>
                                    </StackPanel>
                                </DataTemplate>
                            </ContentControl.ContentTemplate>
                        </ContentControl>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- 底部：状态 + 日志（横跨整个窗口） -->
        <Border DockPanel.Dock="Bottom" BorderBrush="#DDD" BorderThickness="0,1,0,0" Padding="6" Height="128">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top">
                    <Button DockPanel.Dock="Right" Content="清空日志" Width="76" Margin="6,0,0,0" Click="ClearLogs_Click"/>
                    <TextBlock Text="状态：" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
                <GroupBox Header="日志" Margin="0,4,0,0">
                    <ListBox x:Name="LogList" ItemsSource="{Binding Logs}" FontFamily="Consolas" FontSize="11"/>
                </GroupBox>
            </DockPanel>
        </Border>

        <!-- 中间：设计 / 测试 Tab -->
        <TabControl x:Name="MainTabs">
            <TabItem Header="设计">
                <ScrollViewer x:Name="CanvasScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Padding="8">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="24" Background="#F7F7F7" BorderBrush="#CCC" BorderThickness="1,1,1,0">
                            <Canvas x:Name="VRuler" Width="24" Height="{Binding CanvasHeightPx}"/>
                        </Border>
                        <StackPanel Orientation="Vertical">
                            <Border Height="24" Background="#F7F7F7" BorderBrush="#CCC" BorderThickness="1,1,0,1">
                                <Canvas x:Name="HRuler" Width="{Binding CanvasWidthPx}" Height="24"/>
                            </Border>
                            <Border BorderBrush="#999" BorderThickness="1" Background="White">
                                <Canvas x:Name="EditorCanvas" Background="{Binding CanvasBackground}"
                                        Width="{Binding CanvasWidthPx}" Height="{Binding CanvasHeightPx}"
                                        AllowDrop="True"
                                        PreviewMouseLeftButtonDown="Canvas_MouseDown"
                                        PreviewMouseMove="Canvas_MouseMove"
                                        PreviewMouseLeftButtonUp="Canvas_MouseUp"
                                        PreviewMouseDown="Canvas_PreviewMouseDown"
                                        PreviewMouseUp="Canvas_PreviewMouseUp"
                                        PreviewMouseWheel="Canvas_PreviewMouseWheel"
                                        DragOver="Canvas_DragOver"
                                        Drop="Canvas_Drop">
                                    <Canvas.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="左对齐" Tag="Left" Click="AlignMenu_Click"/>
                                            <MenuItem Header="水平居中" Tag="CenterH" Click="AlignMenu_Click"/>
                                            <MenuItem Header="右对齐" Tag="Right" Click="AlignMenu_Click"/>
                                            <MenuItem Header="上对齐" Tag="Top" Click="AlignMenu_Click"/>
                                            <MenuItem Header="垂直居中" Tag="CenterV" Click="AlignMenu_Click"/>
                                            <MenuItem Header="下对齐" Tag="Bottom" Click="AlignMenu_Click"/>
                                            <Separator/>
                                            <MenuItem Header="删除选中" Click="Delete_Click"/>
                                        </ContextMenu>
                                    </Canvas.ContextMenu>
                                </Canvas>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="测试">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="420"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <DockPanel>
                        <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                            <Button Content="打印测试" Width="110" FontWeight="Bold" Click="PrintTest_Click"/>
                            <Button Content="保存模板" Width="90" Margin="6,0,0,0" Click="Save_Click"/>
                        </WrapPanel>
                        <GroupBox Header="测试数据（字段由版式自动推导）">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding TestFields}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="170"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Key}" VerticalAlignment="Center" FontWeight="Bold"/>
                                                <TextBox Grid.Column="1" Margin="6,0,0,0"
                                                         Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </GroupBox>
                    </DockPanel>
                    <GroupBox Grid.Column="1" Header="打印预览（实时，随测试数据 / 设计变化刷新）" Margin="10,0,0,0">
                        <Image x:Name="PreviewImage" Stretch="Uniform" MaxWidth="640" MaxHeight="540" Margin="4"/>
                    </GroupBox>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>