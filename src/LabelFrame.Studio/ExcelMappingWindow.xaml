<Window x:Class="LabelFrame.Studio.ExcelMappingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LabelFrame Studio - Excel 数据导入"
        Width="600" Height="480"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="10">
        <TextBlock DockPanel.Dock="Top" Text="{Binding ExcelFileText}" FontWeight="Bold" FontSize="13" Margin="0,0,0,6"/>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Button DockPanel.Dock="Right" Content="取消" Width="80" Margin="6,0,0,0" Click="Cancel_Click"/>
            <Button DockPanel.Dock="Right" Content="批量打印" Width="90" FontWeight="Bold" Click="Print_Click"/>
        </DockPanel>
        <GroupBox Header="列 → 字段映射（自动按列名匹配，可手工调整）">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding ExcelMappings}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding ExcelColumn}" VerticalAlignment="Center" FontWeight="Bold"/>
                                <ComboBox Grid.Column="1" Margin="6,0,0,0" IsEditable="True" IsTextSearchEnabled="True"
                                          ItemsSource="{Binding DataContext.FieldKeyOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                          Text="{Binding FieldKey, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </GroupBox>
        <TextBlock DockPanel.Dock="Top" Margin="0,6,0,0" FontSize="11" Foreground="#888" TextWrapping="Wrap"
                   Text="提示：每一列选择要填充的字段 Key（可输入新 Key）；不映射的列会被忽略。确认后按数据行批量提交打印作业。"/>
    </DockPanel>
</Window>