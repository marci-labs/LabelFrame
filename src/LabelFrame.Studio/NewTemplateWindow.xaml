<Window x:Class="LabelFrame.Studio.NewTemplateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="新建模板" Height="300" Width="380"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <StackPanel Margin="16">
        <TextBlock Text="模板名（唯一标识）"/>
        <TextBox x:Name="NameBox" Margin="0,2,0,10"/>
        <TextBlock Text="分组（项目 / 客户）"/>
        <TextBox x:Name="GroupBox" Margin="0,2,0,10" Text="默认"/>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="标签宽(mm)" VerticalAlignment="Center"/>
            <TextBox x:Name="WidthBox" Width="60" Margin="4,0" Text="100"/>
            <TextBlock Text="标签高(mm)" VerticalAlignment="Center" Margin="12,0,0,0"/>
            <TextBox x:Name="HeightBox" Width="60" Margin="4,0" Text="60"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="确定" Width="80" IsDefault="True" Click="Ok_Click"/>
            <Button Content="取消" Width="80" Margin="8,0,0,0" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>