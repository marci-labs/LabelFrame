<Window x:Class="LabelFrame.Studio.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:LabelFrame.Studio.ViewModels"
        Title="LabelFrame Studio - 版式编辑（V2）"
        Height="760" Width="1240"
        WindowStartupLocation="CenterOwner">
    <DockPanel>
        <!-- 顶部工具栏 -->
        <Border DockPanel.Dock="Top" BorderBrush="#DDD" BorderThickness="0,0,0,1" Padding="8">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="模板名:" VerticalAlignment="Center"/>
                    <TextBox Width="160" Margin="4,0" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="分组:" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    <TextBox Width="120" Margin="4,0" Text="{Binding Group, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="版本:" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    <TextBox Width="60" Margin="4,0" Text="{Binding Version, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="宽(mm):" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    <TextBox Width="60" Margin="4,0" Text="{Binding WidthMm, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="高(mm):" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    <TextBox Width="60" Margin="4,0" Text="{Binding HeightMm, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="缩放:" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    <Slider Width="140" Minimum="0.5" Maximum="2.5" Value="{Binding Zoom}"/>
                    <Button Content="保存" Width="70" Margin="16,0,0,0" Click="Save_Click"/>
                    <Button Content="刷新预览" Width="90" Margin="4,0" Click="Preview_Click"/>
                </StackPanel>
                <TextBlock Text="{Binding StatusText}" Margin="0,4,0,0" Foreground="#666"/>
            </StackPanel>
        </Border>

        <!-- 左侧：字段 + 元素 -->
        <Border DockPanel.Dock="Left" Width="300" BorderBrush="#DDD" BorderThickness="0,0,1,0" Padding="6">
            <DockPanel>
                <GroupBox DockPanel.Dock="Top" Header="契约字段" Margin="0,0,0,6">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,4,0,0">
                            <Button Content="添加字段" Width="80" Click="AddField_Click"/>
                            <Button Content="删除选中" Width="80" Margin="4,0" Click="RemoveField_Click"/>
                        </StackPanel>
                        <ListBox x:Name="FieldList" Height="150" ItemsSource="{Binding Fields}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <CheckBox IsChecked="{Binding IsRequired}" ToolTip="必填"/>
                                        <TextBlock Text="{Binding Key}" Width="90"/>
                                        <TextBlock Text="{Binding DisplayName}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </GroupBox>

                <GroupBox Header="元素" Margin="0,0,0,6">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,4,0,0">
                            <ComboBox x:Name="ElementTypeBox" Width="100" ItemsSource="{Binding ElementTypes}" SelectedIndex="0"/>
                            <Button Content="添加" Width="60" Margin="4,0" Click="AddElement_Click"/>
                            <Button Content="删除" Width="60" Click="RemoveElement_Click"/>
                        </StackPanel>
                        <ListBox x:Name="ElementList" Height="180" ItemsSource="{Binding Elements}"
                                 DisplayMemberPath="DisplayLabel"
                                 SelectedItem="{Binding SelectedElement}"/>
                    </DockPanel>
                </GroupBox>
            </DockPanel>
        </Border>

        <!-- 右侧：属性面板 -->
        <Border DockPanel.Dock="Right" Width="280" BorderBrush="#DDD" BorderThickness="1,0,0,0" Padding="6">
            <ContentControl Content="{Binding SelectedElement}">
                <ContentControl.ContentTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="属性" FontWeight="Bold" Margin="0,0,0,6"/>
                            <TextBlock Text="类型"/><TextBlock Text="{Binding Type}" FontWeight="Bold" Margin="0,0,0,8"/>
                            <TextBlock Text="X (mm)"/><TextBox Text="{Binding XMm, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="Y (mm)"/><TextBox Text="{Binding YMm, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="来源字段 SourceKey"/><TextBox Text="{Binding SourceKey, UpdateSourceTrigger=PropertyChanged}"/>
                            <StackPanel Visibility="{Binding IsText}">
                                <TextBlock Text="字高 (mm)"/><TextBox Text="{Binding FontHeightMm, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="字宽 (mm)"/><TextBox Text="{Binding FontWidthMm, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Visibility="{Binding IsRect}">
                                <TextBlock Text="宽 (mm)"/><TextBox Text="{Binding WidthMm, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="高 (mm)"/><TextBox Text="{Binding HeightMm, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Visibility="{Binding IsLine}">
                                <TextBlock Text="终点 X2 (mm)"/><TextBox Text="{Binding X2Mm, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="终点 Y2 (mm)"/><TextBox Text="{Binding Y2Mm, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="线宽 (mm)"/><TextBox Text="{Binding ThicknessMm, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <TextBlock Text="提示：在画布上拖动元素可移动。" Foreground="#888" TextWrapping="Wrap" Margin="0,12,0,0"/>
                        </StackPanel>
                    </DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>
        </Border>

        <!-- 中间：画布 + 预览 -->
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="10">
                <Border BorderBrush="#CCC" BorderThickness="1" Background="White"
                        Width="{Binding CanvasWidthPx}" Height="{Binding CanvasHeightPx}"
                        HorizontalAlignment="Left" Margin="0,0,0,12">
                    <Canvas x:Name="EditorCanvas" Background="White"
                            Width="{Binding CanvasWidthPx}" Height="{Binding CanvasHeightPx}"
                            PreviewMouseLeftButtonDown="Canvas_MouseDown"
                            PreviewMouseMove="Canvas_MouseMove"
                            PreviewMouseLeftButtonUp="Canvas_MouseUp"/>
                </Border>
                <GroupBox Header="预览（保存后刷新）">
                    <Image x:Name="PreviewImage" Stretch="Uniform" MaxWidth="860" MaxHeight="420"/>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>