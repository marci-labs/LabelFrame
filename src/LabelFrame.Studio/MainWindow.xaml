<Window x:Class="LabelFrame.Studio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LabelFrame Studio - 作业工作台"
        Height="760" Width="1240"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <!-- 菜单栏 -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="文件(_F)">
                <MenuItem Header="新建模板…" Click="NewTemplate_Click"/>
                <Separator/>
                <MenuItem Header="导入模板包…" Click="Import_Click"/>
                <MenuItem Header="导出模板包…" Click="Export_Click"/>
                <Separator/>
                <MenuItem Header="退出(_X)" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="工具(_T)">
                <MenuItem Header="打印机状态" Click="Status_Click"/>
                <MenuItem Header="打印机测试页" Click="PrinterTest_Click"/>
                <Separator/>
                <MenuItem Header="刷新模板列表" Click="Refresh_Click"/>
            </MenuItem>
        </Menu>

        <!-- 连接栏 -->
        <Border DockPanel.Dock="Top" BorderBrush="#DDD" BorderThickness="0,0,0,1" Padding="8">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="WinHost 地址:" VerticalAlignment="Center"/>
                    <TextBox x:Name="ServerUrlBox" Width="230" Margin="4,0"
                             Text="{Binding ServerUrl, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Content="连接" Width="70" Click="Connect_Click"/>
                    <Button Content="断开" Width="70" Margin="4,0" Click="Disconnect_Click"/>
                    <Button Content="启动 WinHost" Width="110" Margin="4,0" Click="StartWinHost_Click"/>
                    <Button Content="停止" Width="60" Margin="4,0" Click="StopWinHost_Click"/>
                    <TextBlock Text="{Binding ConnectionText}" Margin="16,0,0,0" VerticalAlignment="Center" FontWeight="Bold"/>
                    <TextBlock Text="{Binding TransportText}" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="#666"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="WinHost 可执行文件:" VerticalAlignment="Center"/>
                    <TextBox x:Name="WinHostExeBox" Width="430" Margin="4,0"
                             Text="{Binding WinHostExe, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 左侧：模板列表 -->
        <Border DockPanel.Dock="Left" Width="300" BorderBrush="#DDD" BorderThickness="0,0,1,0" Padding="6">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="分组过滤：" VerticalAlignment="Center"/>
                    <ComboBox x:Name="GroupBox" Margin="0,2"
                              ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}"/>
                    <WrapPanel Margin="0,4">
                        <Button Content="刷新" Width="60" Click="Refresh_Click"/>
                        <Button Content="＋ 新建" Width="70" Margin="4,0" FontWeight="Bold" Click="NewTemplate_Click"/>
                        <Button Content="✏ 编辑" Width="70" Margin="4,0" FontWeight="Bold" Click="Edit_Click"/>
                        <Button Content="删除" Width="60" Click="Delete_Click"/>
                    </WrapPanel>
                    <TextBlock Text="双击模板可直接编辑。" FontSize="11" Foreground="#999" Margin="0,2,0,0"/>
                </StackPanel>
                <ListBox x:Name="TemplateList" Margin="0,4"
                         ItemsSource="{Binding Templates}" DisplayMemberPath="Name"
                         SelectedItem="{Binding SelectedTemplate}"
                         MouseDoubleClick="TemplateList_MouseDoubleClick"/>
            </DockPanel>
        </Border>

        <!-- 右侧：数据 + 打印 -->
        <Border DockPanel.Dock="Right" Width="360" BorderBrush="#DDD" BorderThickness="1,0,0,0" Padding="8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <GroupBox Header="打印数据（按契约字段）">
                        <ItemsControl ItemsSource="{Binding Fields}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Key}" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" Margin="6,0,0,0"
                                                 Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </GroupBox>
                    <WrapPanel Margin="0,8">
                        <Button Content="打印" Width="90" FontWeight="Bold" Click="PrintTest_Click"/>
                        <Button Content="导入数据(Excel)…" Width="130" Margin="4,0" Click="ImportData_Click"/>
                        <Button Content="刷新预览" Width="90" Click="Preview_Click"/>
                    </WrapPanel>
                    <TextBlock Text="{Binding JobStatusText}" TextWrapping="Wrap" Margin="0,4"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 中间：预览 -->
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="12">
                <TextBlock Text="模板预览" FontWeight="Bold" Margin="0,0,0,6"/>
                <Border BorderBrush="#CCC" BorderThickness="1" Background="White" Padding="12" HorizontalAlignment="Left">
                    <Image x:Name="PreviewImage" Source="{Binding PreviewImage}" Stretch="Uniform" MaxWidth="700" MaxHeight="520"/>
                </Border>
                <TextBlock Text="{Binding DetailText}" Margin="0,12,0,0" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>

        <!-- 底部：状态 + 日志 -->
        <Border DockPanel.Dock="Bottom" BorderBrush="#DDD" BorderThickness="0,1,0,0" Padding="6" Height="130">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                    <Button DockPanel.Dock="Right" Content="清空日志" Width="76" Margin="6,0,0,0" HorizontalAlignment="Right" Click="ClearLogs_Click"/>
                    <TextBlock Text="状态：" FontWeight="Bold"/>
                    <TextBlock Text="{Binding ConnectionText}" Margin="4,0,12,0"/>
                    <TextBlock Text="{Binding TransportText}" Margin="0,0,12,0"/>
                </StackPanel>
                <GroupBox Header="日志" Margin="0,4,0,0">
                    <ListBox x:Name="LogList" ItemsSource="{Binding Logs}" FontFamily="Consolas" FontSize="11"/>
                </GroupBox>
            </DockPanel>
        </Border>
    </DockPanel>
</Window>