<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>LabelFrame.Rendering</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- SkiaSharp 版本下限固化（迭代 64 返修，决策 #130）：v0.26.0 发布闭包的 3.119.2 是
         Zebra SDK 传递钉定顺带抬升的，迭代 63（#123）外置化移出后本直接引用即闭包下限，
         若低于 3.119.2 会在 Client MSI 覆盖升级链触发 Windows Installer 组件规则拒装降版
         keyfile（#57 AC-01 实证）。升版时同步上调 scripts/assert-client-deps-baseline.ps1 基线。 -->
    <PackageReference Include="SkiaSharp" Version="3.119.2" />
    <!-- Linux 服务端需要 Skia 原生库；Windows 由主包提供 -->
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="3.119.2" />
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LabelFrame.Core\LabelFrame.Core.csproj" />
  </ItemGroup>

</Project>