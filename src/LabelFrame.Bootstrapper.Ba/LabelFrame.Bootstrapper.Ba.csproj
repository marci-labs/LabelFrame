<Project Sdk="Microsoft.NET.Sdk">

  <!-- WiX Burn 托管 BA（Bootstrapper Application，DESIGN §6.1 决策 #122）：
       WiX v5.4+ out-of-proc 模型——独立 EXE 进程，经 WixToolset.BootstrapperApplicationApi 与 Burn 引擎握手。
       目标框架 net48：.NET Framework 4.8 是 Win10 1809+ / Win11 的 OS 组件，裸机免装运行时（BA 载荷 MB 级）。
       RuntimeIdentifier 使 mbanative.dll（包内 runtimes 资产）复制到输出，随 Bundle 打包为 BA 载荷。 -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <RootNamespace>LabelFrame.Bootstrapper.Ba</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- 品牌 v02（#288）：BA EXE 图标（窗体 / 任务栏）——与 WinHost / Server 同一 ICO 源 -->
    <ApplicationIcon>..\..\assets\labelframe.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- WiX v7 OSMF EULA 接受（WIX7015，MSBuild 集成消费点要求）：与本仓既有 v7 接受口径一致
       （build-msi.ps1 / CI msi-verify job 均已执行 `wix eula accept wix7`）；费用阈值评估见 https://wixtoolset.org/osmf/ -->
  <PropertyGroup>
    <AcceptEula>wix7</AcceptEula>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.BootstrapperApplicationApi" Version="7.0.0" />
  </ItemGroup>

  <!-- 核心库公共 API 暴露 HttpClient（LoadManifestAsync 注入口），net48 需显式引用；完成页服务状态查询用 ServiceController -->
  <ItemGroup>
    <Reference Include="System.Net.Http" />
    <Reference Include="System.ServiceProcess" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LabelFrame.Bootstrapper\LabelFrame.Bootstrapper.csproj" />
  </ItemGroup>

  <!-- 品牌 v02（#288）：向导头部 lockup 以嵌入资源随 BA EXE 携带（LogicalName 钉死清单名，
       不依赖安装期外部文件路径；载荷约 21KB，随 Burn BA 载荷整体打包） -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\assets\brand\bootstrapper-lockup.png" LogicalName="bootstrapper-lockup.png" />
  </ItemGroup>

</Project>
