<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:netfx="http://wixtoolset.org/schemas/v4/wxs/netfx"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="LabelFrame Client" Manufacturer="LabelFrame" Version="$(var.Version)"
           UpgradeCode="EE3F2357-56CE-4C0F-AEC1-4C04B6E6BCDA" Codepage="65001">
    <SummaryInformation Description="LabelFrame 打印客户端：托管完整界面（模板设计 / 数据与打印 / 连接配置 / 日志 / 作业历史）并连接本机打印机打印（安装于 Program Files\LabelFrame\Client）" />
    <MajorUpgrade DowngradeErrorMessage="已安装的 LabelFrame 版本更新，无法降级。" />
    <Property Id="LABELFRAME_MIN_SERVER_VERSION" Value="1.0.0" />
    <Property Id="LABELFRAME_MAX_SERVER_VERSION" Value="2.0.0" />
    <Property Id="LABELFRAME_RUNTIME_MAJOR" Value="10" />
    <!-- 每次安装（向导双击 / 静默）都在用户临时目录自动生成安装日志；日志留在临时目录，不要求用户清理 -->
    <Property Id="MsiLogging" Value="voicewarmupx" />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- 安装向导 UI（欢迎 / 许可 / 安装位置（只读）/ 选项 / 进度 / 完成）+ 品牌资产（assets/ 静态文件，源出 assets/brand/ 母版库）+ 控制面板元数据 -->
    <ui:WixUI Id="WixUI_InstallDir" />
    <Property Id="WIXUI_INSTALLDIR" Value="ClientInstallDir" />
    <WixVariable Id="WixUIDialogBmp" Value="$(var.AssetsDir)/installer-dialog.bmp" />
    <WixVariable Id="WixUIBannerBmp" Value="$(var.AssetsDir)/installer-banner.bmp" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtf)" />
    <!-- 开机自启（安装选项页勾选）：默认开启，控制 HKLM Run 键组件 -->
    <Property Id="AUTO_START" Value="1" />
    <!-- 完成页可选复选框（ExitDialog 自带控件）：文本经属性格式化，默认勾选 -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="立即打开 LabelFrame" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Icon Id="LabelframeAppIco" SourceFile="$(var.AssetsDir)/labelframe.ico" />
    <Property Id="ARPPRODUCTICON" Value="LabelframeAppIco" />
    <Property Id="ARPHELPLINK" Value="https://github.com/marci-labs/LabelFrame" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/marci-labs/LabelFrame/releases" />
    <!-- 卸载询问页的勾选要传进提权的执行会话。
         防回归警示：必须声明为安全属性——以普通方式启动安装程序再进维护向导时，执行会话会忽略不是安全属性的属性
         （安装日志里是 Ignoring disallowed property），勾选「清除用户数据」等于没勾 -->
    <Property Id="CLEAR_USER_DATA" Secure="yes" />


    <!-- 运行时检测：.NET 官方 NetCoreCheck 自检（属性值 0 = 满足；其余为未安装 / 版本不足 / 平台不兼容）。
         客户端同时依赖 ASP.NET Core 与 Desktop 两个共享框架，只查一项会让缺另一项的机器走到启动服务才失败。
         WiX netfx 扩展的 RuntimeType 合法枚举为 aspnet / desktop / core，构建实测 WIX0021。
         不再依赖注册表：版本号是命名值而非默认值，注册表搜索读不到。 -->
    <netfx:DotNetCompatibilityCheck Id="DotNet10AspNetCheck"
                                    Property="DOTNET10_PRESENT"
                                    Platform="x64"
                                    RuntimeType="aspnet"
                                    Version="10.0.0"
                                    RollForward="latestMajor" />
    <netfx:DotNetCompatibilityCheck Id="DotNet10DesktopCheck"
                                    Property="DOTNET10_DESKTOP_PRESENT"
                                    Platform="x64"
                                    RuntimeType="desktop"
                                    Version="10.0.0"
                                    RollForward="latestMajor" />
    <!-- 平台坑：只装了 ASP.NET Core Runtime 而没有 .NET Runtime 时两项检测都不满足（检测工具找不到宿主），
         所以「两项都不满足」按没有可用的 .NET 10 提示，不能说成 ASP.NET Core 未安装。
         微软的 ASP.NET Core Runtime 独立安装包不含 .NET Runtime，Hosting Bundle 才含；Desktop Runtime 自带 .NET Runtime。
         防回归警示：启动条件是「为真才放行」，第一条必须在「至少一项可用」时为真，否则只要缺任何一项都先弹它的笼统提示，
         后两条精确提示永远轮不到；三条件的顺序不能换。 -->
    <Launch Condition="(DOTNET10_PRESENT = &quot;0&quot; OR DOTNET10_DESKTOP_PRESENT = &quot;0&quot;) OR UILevel = 5 OR REMOVE"
      Message="未检测到可用的 .NET 10 运行时（x64）。LabelFrame 需要 .NET Desktop Runtime 10 和 ASP.NET Core Runtime 10 两项，请都安装 x64 版本后重新运行安装程序。下载：https://dotnet.microsoft.com/download/dotnet/10.0" />
    <Launch Condition="DOTNET10_DESKTOP_PRESENT = &quot;0&quot; OR UILevel = 5 OR REMOVE"
      Message="未检测到可用的 .NET Desktop Runtime 10（x64）：可能未安装、版本低于 10，或装的不是 x64 版本。请安装后重新运行安装程序。下载：https://dotnet.microsoft.com/download/dotnet/10.0" />
    <Launch Condition="DOTNET10_PRESENT = &quot;0&quot; OR UILevel = 5 OR REMOVE"
      Message="缺少可用的 ASP.NET Core Runtime 10（x64）：可能未安装、版本低于 10，或装的不是 x64 版本。请安装后重新运行安装程序。下载：https://dotnet.microsoft.com/download/dotnet/10.0" />

    <!-- 安装位置固定：目录标识含小写字母，不是公开属性，命令行传入 INSTALLFOLDER 改不了安装位置；
         显式传入时直接拦下并说明，而不是静默装到别处 -->
    <Launch Condition="NOT INSTALLFOLDER"
      Message="LabelFrame 客户端固定安装到 [ProgramFiles64Folder]LabelFrame\Client，不支持通过 INSTALLFOLDER 指定安装目录。请去掉该参数后重新运行安装程序。" />

    <!-- 检测 WebView2 Evergreen 运行时：界面窗口（WebView2 嵌入）依赖；
         注册表 EdgeUpdate Clients 的 WebView2 产品键（per-machine 走 WOW6432Node 视图 / per-user HKCU），
         键随运行时安装即写入 → 向导内「重新检测」装完即可继续（无需重启安装程序）。
         全 UI 缺失时由 WebView2MissingDlg 引导（下方）；静默 / 基础 UI 由 LaunchCondition 拦截。 -->
    <Property Id="WEBVIEW2_HKLM">
      <RegistrySearch Id="WebView2PerMachine" Root="HKLM" Key="SOFTWARE\WOW6432Node\Microsoft\EdgeUpdate\Clients\{F3017226-FE2A-4295-8BDF-00C3A9A7E4C5}" Name="pv" Type="raw" />
    </Property>
    <Property Id="WEBVIEW2_HKCU">
      <RegistrySearch Id="WebView2PerUser" Root="HKCU" Key="SOFTWARE\Microsoft\EdgeUpdate\Clients\{F3017226-FE2A-4295-8BDF-00C3A9A7E4C5}" Name="pv" Type="raw" />
    </Property>
    <!-- 「重新检测」实现：外部 VBScript 立即时动作重读注册表（WiX v7 移除内联脚本，须 ScriptSourceFile）；
         VBScript 为已弃用组件（WIX1163）：仅用于本按钮的重新检测，退出按钮不依赖它 -->
    <CustomAction Id="RecheckWebView2" Script="vbscript" ScriptSourceFile="$(var.PackagingDir)/recheck-webview2.vbs" />
    <Launch Condition="WEBVIEW2_HKLM OR WEBVIEW2_HKCU OR UILevel = 5 OR REMOVE"
      Message="本机未检测到 Microsoft Edge WebView2 运行时（LabelFrame 界面窗口依赖），请先安装后重新运行安装程序。下载：https://go.microsoft.com/fwlink/p/?LinkId=2124703" />

    <!-- 运行时缺失对话框：显示官方下载页的网址，由「打开下载页」按钮在默认浏览器里打开。
         向导以失败收场时显示界面库的标准「提前结束」页，其说明文字由 packaging\wixui-zh-cn-override.wxl 补上安装日志的位置 -->
    <UI Id="RuntimeCheckUI">
      <!-- 运行时缺失对话框：按实际缺的那一项说明，三段说明共用一个位置，由控件显示条件择一。
           平台坑：显示条件为真时才显示，为假时并不隐藏，所以三段必须默认隐藏，否则全部叠在一起、最后一段盖住其余。
           平台坑：网址不能用安装器的 Hyperlink 控件——它对鼠标点击没有反应，只有焦点在链接上时按回车才打开。
           网址用普通文字显示，打开动作放在按钮上 -->
      <Dialog Id="RuntimeMissingDlg" X="50" Y="50" Width="370" Height="230"
              Title="LabelFrame 安装 - 缺少 .NET 运行时" NoMinimize="yes">
        <Control Id="NoRuntimeText" Type="Text" X="15" Y="15" Width="340" Height="48" Hidden="yes"
                 Text="未检测到可用的 .NET 10 运行时（x64）。LabelFrame 需要 .NET Desktop Runtime 10 和 ASP.NET Core Runtime 10 两项，请都安装 x64 版本后再运行本安装程序。"
                 ShowCondition="NOT DOTNET10_PRESENT = &quot;0&quot; AND NOT DOTNET10_DESKTOP_PRESENT = &quot;0&quot;" />
        <Control Id="DesktopMissingText" Type="Text" X="15" Y="15" Width="340" Height="48" Hidden="yes"
                 Text="未检测到可用的 .NET Desktop Runtime 10（x64）：可能未安装、版本低于 10，或装的不是 x64 版本。请安装后再运行本安装程序。"
                 ShowCondition="DOTNET10_PRESENT = &quot;0&quot; AND NOT DOTNET10_DESKTOP_PRESENT = &quot;0&quot;" />
        <Control Id="AspNetMissingText" Type="Text" X="15" Y="15" Width="340" Height="48" Hidden="yes"
                 Text="缺少可用的 ASP.NET Core Runtime 10（x64）：可能未安装、版本低于 10，或装的不是 x64 版本。请安装后再运行本安装程序。"
                 ShowCondition="DOTNET10_DESKTOP_PRESENT = &quot;0&quot; AND NOT DOTNET10_PRESENT = &quot;0&quot;" />
        <Control Id="HintText" Type="Text" X="15" Y="75" Width="340" Height="20"
                 Text="微软官方下载页（两项都在这里，都选 x64）：" />
        <Control Id="RuntimeDownloadUrl" Type="Text" X="15" Y="100" Width="340" Height="25"
                 Text="https://dotnet.microsoft.com/download/dotnet/10.0" />
        <Control Id="OpenDownloadButton" Type="PushButton" X="165" Y="190" Width="100" Height="25" Text="打开下载页(&amp;O)">
          <!-- 两条事件按登记顺序执行：先把目标网址交给打开动作，再打开 -->
          <Publish Event="DoAction" Value="SetDownloadPageTarget" Order="1" Condition="1" />
          <Publish Event="DoAction" Value="OpenDownloadPage" Order="2" Condition="1" />
        </Control>
        <Control Id="ExitButton" Type="PushButton" X="280" Y="190" Width="75" Height="25"
                 Text="退出" Default="yes" Cancel="yes">
          <Publish Event="EndDialog" Value="Exit" Condition="1" />
        </Control>
      </Dialog>
      <!-- WebView2 运行时缺失（全 UI）：官方下载页按钮 + 重新检测（注册表键随运行时安装即写入，装完点重新检测即可继续，无需重启安装程序） -->
      <Dialog Id="WebView2MissingDlg" X="50" Y="50" Width="370" Height="200"
              Title="LabelFrame 安装 - 缺少 WebView2 运行时" NoMinimize="yes">
        <Control Id="TitleText" Type="Text" X="15" Y="15" Width="340" Height="40"
                 Text="本机未检测到 Microsoft Edge WebView2 运行时（LabelFrame 界面窗口需要），请先安装。" />
        <Control Id="HintText" Type="Text" X="15" Y="62" Width="340" Height="20"
                 Text="微软官方下载页（Evergreen 版本）：" />
        <Control Id="WebView2DownloadUrl" Type="Text" X="15" Y="87" Width="340" Height="25"
                 Text="https://go.microsoft.com/fwlink/p/?LinkId=2124703" />
        <Control Id="HintText2" Type="Text" X="15" Y="118" Width="340" Height="20"
                 Text="安装完成后点击「重新检测」继续本安装程序。" />
        <Control Id="OpenDownloadButton" Type="PushButton" X="75" Y="160" Width="90" Height="25" Text="打开下载页(&amp;O)">
          <Publish Event="DoAction" Value="SetWebView2DownloadPageTarget" Order="1" Condition="1" />
          <Publish Event="DoAction" Value="OpenDownloadPage" Order="2" Condition="1" />
        </Control>
        <Control Id="RetryButton" Type="PushButton" X="177" Y="160" Width="90" Height="25" Text="重新检测">
          <Publish Event="DoAction" Value="RecheckWebView2" />
          <Publish Event="EndDialog" Value="Return" Condition="WEBVIEW2_OK = &quot;1&quot;" />
        </Control>
        <Control Id="ExitButton" Type="PushButton" X="280" Y="160" Width="75" Height="25"
                 Text="退出" Default="yes" Cancel="yes">
          <Publish Event="EndDialog" Value="Exit" />
        </Control>
      </Dialog>
      <!-- 卸载时询问是否清除用户数据（默认不勾选；仅手动卸载，不适用于升级）。
           平台坑：询问页必须排在执行之前，而 Windows Installer 在卸载时按「是不是已经装了、是不是命令行预选了功能」
           决定显示哪一页——命令行带 REMOVE=ALL 时显示界面库的「继续安装」页，维护向导里选「删除」时不经过界面序列；
           所以两个入口都要接：界面序列里的显示条件（下方）只覆盖命令行入口，向导入口靠维护向导「删除」按钮的跳转 -->
      <Dialog Id="ClearDataDlg" X="50" Y="50" Width="370" Height="170"
              Title="LabelFrame Client 卸载" NoMinimize="yes">
        <Control Id="TitleText" Type="Text" X="15" Y="15" Width="340" Height="25" Text="卸载 LabelFrame Client。" />
        <Control Id="HintText" Type="Text" X="15" Y="45" Width="340" Height="30"
                 Text="是否同时清除本程序产生的用户数据（模板 / 作业 / 日志 / 连接与打印配置）？" />
        <Control Id="ClearDataCheck" Type="CheckBox" X="15" Y="85" Width="340" Height="18"
                 Property="CLEAR_USER_DATA" CheckBoxValue="1" Text="清除用户数据" />
        <!-- 「上一步」只在维护向导入口显示：命令行入口的功能是预选的，回到维护向导再选别的操作会与 REMOVE=ALL 叠加 -->
        <Control Id="BackButton" Type="PushButton" X="120" Y="135" Width="75" Height="25"
                 Text="上一步(&amp;B)" Hidden="yes"
                 ShowCondition="WixUI_InstallMode = &quot;Remove&quot; AND NOT Preselected">
          <Publish Event="NewDialog" Value="MaintenanceTypeDlg" />
        </Control>
        <Control Id="CancelButton" Type="PushButton" X="200" Y="135" Width="75" Height="25"
                 Text="取消" Cancel="yes">
          <!-- 命令行入口直接退出；向导入口与其他向导页一致，先确认再退出 -->
          <Publish Event="SpawnDialog" Value="CancelDlg" Condition="WixUI_InstallMode = &quot;Remove&quot;" />
          <Publish Event="EndDialog" Value="Exit" Condition="NOT WixUI_InstallMode" />
        </Control>
        <!-- 防回归警示：界面库按「安装模式」属性决定确认页与进度页用哪套文字，命令行入口没有「删除」按钮替它赋值，
             必须先把属性置为 Remove 再进确认页 -->
        <Control Id="NextButton" Type="PushButton" X="280" Y="135" Width="75" Height="25"
                 Text="继续" Default="yes">
          <Publish Event="DoAction" Value="SetRemoveInstallMode" Order="1" Condition="NOT WixUI_InstallMode" />
          <Publish Event="NewDialog" Value="VerifyReadyDlg" Order="2" Condition="WixUI_InstallMode = &quot;Remove&quot;" />
        </Control>
      </Dialog>
      <!-- 安装目录页（只读）：更新服务只接受 Program Files 下的安装目录，所以不提供修改入口；页面上只有「安装目录」和路径，不加解释。
           防回归警示：WiX 自带向导组里可改目录的那一页不能单独替换（重复定义，编译失败），它仍留在包里；
           这里靠「同一按钮上登记顺序靠后的跳转生效」把它旁路，接法由结构断言脚本守住 -->
      <Dialog Id="InstallLocationDlg" Width="370" Height="270" Title="[ProductName] 安装">
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="yes" Text="WixUI_Bmp_Banner" />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="200" Height="15" Transparent="yes" TabSkip="yes"
                 Text="{\WixUI_Font_Title}安装目录" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="InstallLocationText" Type="Text" X="20" Y="75" Width="330" Height="40" NoPrefix="yes" Text="[ClientInstallDir]" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="上一步(&amp;B)">
          <Publish Event="NewDialog" Value="LicenseAgreementDlg" />
        </Control>
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="下一步(&amp;N)">
          <Publish Event="NewDialog" Value="OptionsDlg" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="取消">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
      </Dialog>
      <!-- 安装选项页：安装位置页之后、确认安装页之前 -->
      <Dialog Id="OptionsDlg" Width="370" Height="270" Title="[ProductName] 安装">
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="yes" Text="WixUI_Bmp_Banner" />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="200" Height="15" Transparent="yes" TabSkip="yes"
                 Text="{\WixUI_Font_Title}安装选项" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="AutoStartCheck" Type="CheckBox" X="20" Y="80" Width="300" Height="17"
                 Property="AUTO_START" CheckBoxValue="1" Text="开机自动启动 LabelFrame" />
        <Control Id="AutoStartHint" Type="Text" X="20" Y="105" Width="320" Height="40"
                 Text="开机自启以托盘方式常驻运行，不自动打开界面窗口；可随时从托盘图标打开界面或退出。" />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="上一步(&amp;B)">
          <Publish Event="NewDialog" Value="InstallLocationDlg" />
        </Control>
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Text="下一步(&amp;N)">
          <Publish Event="NewDialog" Value="VerifyReadyDlg" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="取消">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
      </Dialog>
      <!-- 向导链路：许可页 Next 进只读的安装位置页 → 选项页 → 确认页；确认页 Back（仅全新安装）回选项页。
           ControlEvent 重复发布时后执行者生效，Order 越大越后执行：许可页 Next 与确认页 Back 上自带向导组的
           默认目标仍是那一页可改目录的旧页，这里的登记顺序必须更大 -->
      <Publish Dialog="LicenseAgreementDlg" Control="Next" Event="NewDialog" Value="InstallLocationDlg" Order="10"
               Condition="NOT Installed" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="OptionsDlg" Order="10"
               Condition="NOT Installed AND NOT REMOVE" />
      <!-- 卸载链路：维护向导的「删除」先经询问页；「确认删除」页的「上一步」回询问页（界面库默认回维护向导的类型页） -->
      <Publish Dialog="MaintenanceTypeDlg" Control="RemoveButton" Event="NewDialog" Value="ClearDataDlg" Order="10" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="ClearDataDlg" Order="10"
               Condition="WixUI_InstallMode = &quot;Remove&quot;" />
      <!-- 向导完成页启动：对 UI 扩展库的 ExitDialog 追加控件事件（勾选 + 全新安装才启动）。
           两条事件按登记顺序执行：先把目标程序交给启动动作，再启动。界面库在这一页的「完成」上另有登记顺序为 999 的关窗事件，排在它们之后 -->
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="SetLaunchClientTarget" Order="1"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = &quot;1&quot; AND NOT Installed" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchClientOnExit" Order="2"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = &quot;1&quot; AND NOT Installed" />
    </UI>
    <InstallUISequence>
      <Show Dialog="RuntimeMissingDlg" Sequence="1150"
            Condition="(NOT DOTNET10_PRESENT = &quot;0&quot; OR NOT DOTNET10_DESKTOP_PRESENT = &quot;0&quot;) AND NOT REMOVE" />
      <!-- WebView2 检测在 .NET 检测之后（两者都缺时先引导 .NET）；全 UI 才显示，静默 / 基础 UI 由 LaunchCondition 拦截 -->
      <Show Dialog="WebView2MissingDlg" Sequence="1160"
            Condition="NOT WEBVIEW2_HKLM AND NOT WEBVIEW2_HKCU AND DOTNET10_PRESENT = &quot;0&quot; AND DOTNET10_DESKTOP_PRESENT = &quot;0&quot; AND NOT REMOVE" />
      <Show Dialog="ClearDataDlg" Sequence="1290"
            Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <!-- 命令行带 REMOVE=ALL 时，询问页之后不再显示界面库的「继续安装」页：它按安装措辞写成，卸载时文不对题；
           询问页自己进入「确认删除」页。这一行替换界面库里同一页的显示条件 -->
      <Show Dialog="override ResumeDlg" Before="ProgressDlg"
            Condition="Installed AND (RESUME OR Preselected) AND NOT (REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE)" />
      <!-- 同一条路径上，界面库的进度页会按「命令行预选了功能」把「正在安装」的两段文字也显示出来，和「正在删除」叠在一起。
           预选标记只在这两条显示条件里用到：询问页之后把它清掉，再让维护欢迎页（它的条件看的是同一个标记的反面）不在这一路径上显示。
           这一行替换界面库里维护欢迎页的显示条件 -->
      <Custom Action="ClearPreselectedAfterQuestion" Before="ResumeDlg"
              Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Show Dialog="override MaintenanceWelcomeDlg" Before="ProgressDlg"
            Condition="Installed AND NOT RESUME AND NOT Preselected AND NOT PATCH AND NOT (REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE)" />
    </InstallUISequence>

    <!-- 安装目录：Program Files\LabelFrame\Client（64 位）。目录标识含小写字母 = 非公开属性，安装位置无法从外部改写 -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="LABELFRAMEROOT" Name="LabelFrame">
      <Directory Id="ClientInstallDir" Name="Client">
      <!-- 官方插件附带包：随 MSI 携带 Zebra / TSPL 外置插件包，供存量升级自动安装
           （OfficialPluginMigration 启动检测已用官方插件配置 → 从本目录自动装外置插件）。
           build-msi.ps1 检测到 artifacts 下的 .lfplugin 时传入 -d ZebraPluginPackage / -d TsplPluginPackage
           才编译对应块（本地无产物可跳过）。 -->
      <?ifdef ZebraPluginPackage?>
      <Directory Id="PluginPackagesDir" Name="plugin-packages">
        <Component Id="ZebraPluginPackageFile" Guid="7C4E1B2A-9D53-4F86-B8A1-3E2D5C7F9A04">
          <File Id="ZebraPluginPackageFile" Source="$(var.ZebraPluginPackage)" KeyPath="yes" />
        </Component>
      </Directory>
      <?endif?>
      <?ifdef TsplPluginPackage?>
      <Directory Id="TsplPluginPackagesDir" Name="plugin-packages">
        <Component Id="TsplPluginPackageFile" Guid="A2B8D4F6-3C71-4E9A-8B05-D7E1F3A9C624">
          <File Id="TsplPluginPackageFile" Source="$(var.TsplPluginPackage)" KeyPath="yes" />
        </Component>
      </Directory>
      <?endif?>
      <!-- 用户配置 appsettings.json：独立组件、GUID 固定；NeverOverwrite 升级/修复不覆盖，
           Permanent 卸载不删除，保留用户数据（新装仍写入默认配置） -->
      <Component Id="AppSettingsFile" Guid="B0E5FE56-15B9-4373-9F93-F0C5380D0060" NeverOverwrite="yes" Permanent="yes">
        <File Id="AppSettingsFile" Source="$(var.PublishDir)/appsettings.json" KeyPath="yes" />
      </Component>
    </Directory>
    </Directory>
    </StandardDirectory>

    <!-- 开机自启注册表（HKLM Run 键）：由隐藏子 Feature 的 Level 条件控制——安装选项页未勾选（AUTO_START 空）时 Level=0 不安装。
         防回归警示：组件必须挂在某个目录引用下，写在包顶层会被 WiX 挂到名为 INSTALLFOLDER 的默认目录 -->
    <DirectoryRef Id="ClientInstallDir">
      <Component Id="AutoStartRunKey" Guid="3F8A9C71-6B2D-4E45-9A10-58C6E2D7B013">
        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\Run"
                       Name="LabelFrame" Type="string" Value="&quot;[#WinHostExe]&quot; --autostart" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <!-- 开始菜单 -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="LabelFrame">
        <Component Id="StartMenuShortcut">
          <Shortcut Id="StartMenuShortcut" Name="LabelFrame Client"
                    Description="打开 LabelFrame 界面编辑与打印标签"
                    Target="[#WinHostExe]"
                    WorkingDirectory="ClientInstallDir" />
          <RemoveFolder Id="ApplicationProgramsRemove" Directory="ApplicationProgramsFolder" On="uninstall" />
          <RegistryValue Root="HKCU" Key="Software\LabelFrame" Name="startmenu" Type="integer" Value="1" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <!-- 桌面快捷方式 -->
    <StandardDirectory Id="DesktopFolder">
      <Component Id="DesktopShortcut">
        <Shortcut Id="DesktopShortcut" Name="LabelFrame Client"
                  Description="打开 LabelFrame 界面编辑与打印标签"
                  Target="[#WinHostExe]"
                  WorkingDirectory="ClientInstallDir" />
        <RemoveFolder Id="DesktopRemove" Directory="DesktopFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\LabelFrame" Name="desktop" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <Feature Id="MainFeature" Title="LabelFrame" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentGroupRef Id="WebFiles" />
      <ComponentRef Id="AppSettingsFile" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />
      <?ifdef ZebraPluginPackage?>
      <ComponentRef Id="ZebraPluginPackageFile" />
      <?endif?>
      <?ifdef TsplPluginPackage?>
      <ComponentRef Id="TsplPluginPackageFile" />
      <?endif?>
      <Feature Id="AutoStartFeature" Level="1" Display="hidden">
        <Level Value="0" Condition="NOT AUTO_START" />
        <ComponentRef Id="AutoStartRunKey" />
      </Feature>
    </Feature>

    <!-- 隐藏执行客户端的安全退出预检：安装、修复、升级与手动卸载共用。
         MSI Formatted 会剥除空花括号并替换方括号引用，内层脚本禁止空块和方括号类型表达式。 -->
    <CustomAction Id="ShutdownWinHost" BinaryRef="Wix4UtilCA_X64" DllEntry="WixQuietExec" Execute="immediate" Return="check" />
    <CustomAction Id="SetShutdownWinHostCommand" Property="WixQuietExecCmdLine"
      Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command &quot;$ErrorActionPreference='Stop'; $servicePids=@(Get-CimInstance Win32_Service -Filter 'Name=''LabelFrameClientUpdater''' -ErrorAction Stop | Select-Object -ExpandProperty ProcessId); $p=Get-CimInstance Win32_Process -Filter 'Name=''LabelFrame.WinHost.exe''' -ErrorAction Stop | Where-Object { $_.ProcessId -notin $servicePids -and $_.CommandLine -notmatch '(^|\s)--(update-service|restart-wait)(\s|$)' } | Select-Object -First 1; if (!$p) { exit 0 }; $pidToStop=$p.ProcessId; $ports=@(Get-NetTCPConnection -State Listen -OwningProcess $pidToStop -ErrorAction SilentlyContinue | Select-Object -ExpandProperty LocalPort -Unique); if (!$ports) { Write-Error 'LabelFrame 正在运行但无法定位本机 API 端口，已中止安装或卸载'; exit 1 }; $base=$null; foreach ($port in $ports) { try { $jobs=@(Invoke-RestMethod -TimeoutSec 3 -Uri ('http://127.0.0.1:'+$port+'/api/jobs?limit=500')); $base='http://127.0.0.1:'+$port; break } catch { $null } }; if (!$base) { Write-Error '无法读取 LabelFrame 作业状态，已中止安装或卸载'; exit 1 }; $busy=@($jobs | Where-Object { $_.status -eq 'Printing' -or @($_.items | Where-Object { $_.status -eq 'Printing' }).Count -gt 0 }); if ($busy.Count -gt 0) { Write-Error 'LabelFrame 当前有标签正在打印，请等待本张完成后重试'; exit 1 }; try { Invoke-WebRequest -UseBasicParsing -Method Post -TimeoutSec 2 -Uri ($base+'/api/host/shutdown') | Out-Null } catch { if ($_.Exception.Response -and $_.Exception.Response.StatusCode.value__ -eq 409) { Write-Error 'LabelFrame 当前有标签正在打印，请等待本张完成后重试'; exit 1 }; Write-Error '无法请求 LabelFrame 安全退出，已中止安装或卸载'; exit 1 }; $deadline=(Get-Date).AddSeconds(15); do { Start-Sleep -Milliseconds 250; $p=Get-Process -Id $pidToStop -ErrorAction SilentlyContinue } while ($p -and (Get-Date) -lt $deadline); if ($p) { Write-Error 'LabelFrame 未能在 15 秒内安全退出，已中止安装或卸载'; exit 1 }&quot;" />
    <!-- 更新服务由本包自己启动并等到就绪，不走 Windows Installer 内建的服务启动动作：
         平台坑：内建动作在服务启动失败时会按固定间隔反复重试（实测约 4 分钟才报错），也不会把服务侧的失败原因写进安装日志。
         本动作以 SYSTEM 身份运行刚装好的程序文件：服务一报告停止即判失败，超时只作兜底。
         平台坑：安装器按 UTF-8 记录子进程输出，而安装日志文件是系统代码页，混排会乱码——所以进安装日志的只有 ASCII 结论，
         中文详情写到安装日志旁边的明细日志（路径经 [MsiLogFileLocation] 传给启动入口） -->
    <CustomAction Id="StartUpdaterService" BinaryRef="Wix4UtilCA_X64" DllEntry="WixQuietExec" Execute="deferred" Return="check" Impersonate="no" />
    <SetProperty Id="StartUpdaterService" Value="&quot;[#WinHostExe]&quot; --start-update-service --log &quot;[MsiLogFileLocation].updater-service.log&quot;" Before="StartUpdaterService" Sequence="execute" />
    <!-- 服务起来之后安装若回滚，得先把服务停下再删文件；服务自身退出最长要 30 秒，Stop-Service 会等到停止为止。
         失败不影响回滚继续（Return=ignore） -->
    <CustomAction Id="StopUpdaterServiceOnRollback" BinaryRef="Wix4UtilCA_X64" DllEntry="WixQuietExec" Execute="rollback" Return="ignore" Impersonate="no" />
    <SetProperty Id="StopUpdaterServiceOnRollback"
      Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -Command &quot;Stop-Service -Name LabelFrameClientUpdater -Force -ErrorAction SilentlyContinue&quot;"
      Before="StopUpdaterServiceOnRollback" Sequence="execute" />
    <!-- 完成页「立即打开」与各对话框的「打开下载页」：安装器扩展库的「请桌面外壳启动」动作。
         桌面外壳以当前登录用户的不提权身份启动目标，安装程序以管理员身份运行时，客户端和浏览器也不会跟着提权；
         外壳接手后动作就返回，向导照常结束。启动不了（没有桌面外壳）不影响已经完成的安装，所以失败不阻断。
         防回归警示：不能改成「不等结果」的异步 EXE 动作——向导最后一步触发它时安装会话随即结束，动作起不来。
         目标经属性交给动作，每个目标各用一条赋值动作，由按钮事件按登记顺序紧挨在启动之前执行 -->
    <CustomAction Id="LaunchClientOnExit" BinaryRef="Wix4UtilCA_X64" DllEntry="WixUnelevatedShellExec" Execute="immediate" Return="ignore" Impersonate="yes" />
    <CustomAction Id="OpenDownloadPage" BinaryRef="Wix4UtilCA_X64" DllEntry="WixUnelevatedShellExec" Execute="immediate" Return="ignore" Impersonate="yes" />
    <CustomAction Id="SetLaunchClientTarget" Property="WixUnelevatedShellExecTarget" Value="[#WinHostExe]" />
    <CustomAction Id="SetDownloadPageTarget" Property="WixUnelevatedShellExecTarget" Value="https://dotnet.microsoft.com/download/dotnet/10.0" />
    <CustomAction Id="SetWebView2DownloadPageTarget" Property="WixUnelevatedShellExecTarget" Value="https://go.microsoft.com/fwlink/p/?LinkId=2124703" />
    <!-- 卸载询问页的「继续」把界面库的安装模式置为「删除」：确认页与进度页据此显示卸载的文字 -->
    <CustomAction Id="SetRemoveInstallMode" Property="WixUI_InstallMode" Value="Remove" />
    <CustomAction Id="ClearPreselectedAfterQuestion" Property="Preselected" Value="" />
    <!-- 清除用户数据（勾选 CLEAR_USER_DATA 且为手动卸载时执行；升级不触发）：删除整个用户数据目录。
         作业、模板、日志、模拟打印出图、连接与打印设置、界面缓存都在这个目录里，按文件名逐个列总会漏。
         用户数据目录以用户身份删：%LOCALAPPDATA% 要按当前用户的目录展开，用户对自己的文件本来就有全部权限。
         机器级设置删除后目录空了则一并删除；同一目录下的插件目录不是用户数据，所以这条不带 /s。
         客户端自己的 appsettings.json 是用户配置，一并删除。
         平台坑：机器级的两条以安装自己的提权身份执行——以普通方式启动安装程序再进维护向导时，
         模拟用户的延迟动作拿不到管理员权限，删不掉 ProgramData 与 Program Files 下的文件（动作照常「成功」，什么都没删） -->
    <CustomAction Id="ClearDataDelUserDir" Directory="SystemFolder" Execute="deferred" Impersonate="yes" Return="ignore"
      ExeCommand="cmd.exe /c rmdir /s /q &quot;%LOCALAPPDATA%\LabelFrame&quot;" />
    <CustomAction Id="ClearDataDelMachineConfig" Directory="SystemFolder" Execute="deferred" Impersonate="no" Return="ignore"
      ExeCommand="cmd.exe /c del /q &quot;%ProgramData%\LabelFrame\Client\settings.json&quot; &amp; rmdir /q &quot;%ProgramData%\LabelFrame\Client&quot;" />
    <CustomAction Id="ClearDataDelAppSettings" Directory="SystemFolder" Execute="deferred" Impersonate="no" Return="ignore"
      ExeCommand="cmd.exe /c del /q &quot;%ProgramFiles%\LabelFrame\Client\appsettings.json&quot;" />
    <InstallExecuteSequence>
      <!-- CostFinalize 后、InstallValidate 前停止宿主，避免文件占用检查先弹出 Restart Manager 对话框。
           防回归警示：Restart Manager 关不掉托盘里的客户端，手动卸载不能交给它，必须走同一预检。
           升级过程中旧产品的卸载子会话跳过：新产品的会话已经让客户端退出。 -->
      <Custom Action="ShutdownWinHost" Before="InstallValidate" Condition="NOT (REMOVE~=&quot;ALL&quot; AND UPGRADINGPRODUCTCODE)" />
      <Custom Action="SetShutdownWinHostCommand" Before="ShutdownWinHost" Condition="NOT (REMOVE~=&quot;ALL&quot; AND UPGRADINGPRODUCTCODE)" />
      <!-- 服务注册（InstallServices）之后、提交（InstallFinalize）之前启动更新服务：失败时整笔安装连同服务注册一起回滚 -->
      <Custom Action="StartUpdaterService" After="InstallServices" Condition="NOT REMOVE" />
      <Custom Action="StopUpdaterServiceOnRollback" Before="SetStartUpdaterService" Condition="NOT REMOVE" />
      <Custom Action="ClearDataDelUserDir" After="RemoveFiles" Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE AND CLEAR_USER_DATA=&quot;1&quot;" />
      <Custom Action="ClearDataDelMachineConfig" After="RemoveFiles" Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE AND CLEAR_USER_DATA=&quot;1&quot;" />
      <Custom Action="ClearDataDelAppSettings" After="RemoveFiles" Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE AND CLEAR_USER_DATA=&quot;1&quot;" />
    </InstallExecuteSequence>
  </Package>
</Wix>
