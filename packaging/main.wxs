<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:netfx="http://wixtoolset.org/schemas/v4/wxs/netfx">
  <Package Name="LabelFrame" Manufacturer="LabelFrame" Version="0.12.1"
           UpgradeCode="8B1E4F2A-6C3D-4E5F-9A0B-1C2D3E4F5A6B">
    <SummaryInformation Description="LabelFrame 单机标签设计与打印工具" />
    <MajorUpgrade DowngradeErrorMessage="已安装的 LabelFrame 版本更新，无法降级。" />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- 检测 .NET Desktop Runtime：改用 .NET 官方 NetCoreCheck 自检（属性值 0=满足；12289=未安装；12290=版本不足；13=平台不兼容） -->
    <!-- 之前的注册表搜索读不到运行时，因为版本号是命名值而非默认值，这里不再依赖注册表结构 -->
    <netfx:DotNetCompatibilityCheck Id="DotNet10RuntimeCheck"
                                    Property="DOTNET10_PRESENT"
                                    Platform="x64"
                                    RuntimeType="desktop"
                                    Version="10.0.0"
                                    RollForward="latestMajor" />
    <Launch Condition="DOTNET10_PRESENT = &quot;0&quot; OR UILevel = 5 OR REMOVE"
      Message="本机未检测到 .NET Desktop Runtime，请先安装后重新运行安装程序。下载：https://dotnet.microsoft.com/download/dotnet/10.0" />

    <!-- 运行时缺失对话框：可点击官方下载链接（MSI Hyperlink 控件） -->
    <UI Id="RuntimeCheckUI">
      <Dialog Id="RuntimeMissingDlg" X="50" Y="50" Width="370" Height="180"
              Title="LabelFrame 安装 - 缺少 .NET Desktop Runtime" NoMinimize="yes">
        <Control Id="TitleText" Type="Text" X="15" Y="15" Width="340" Height="30"
                 Text="本机未检测到 .NET 10 Desktop Runtime，请先安装后再运行本安装程序。" />
        <Control Id="HintText" Type="Text" X="15" Y="50" Width="340" Height="20"
                 Text="点击下方链接打开微软官方下载页：" />
        <Control Id="RuntimeLink" Type="Hyperlink" X="15" Y="75" Width="340" Height="25"
                 Text="&lt;a href=&quot;https://dotnet.microsoft.com/download/dotnet/10.0&quot;&gt;https://dotnet.microsoft.com/download/dotnet/10.0&lt;/a&gt;" />
        <Control Id="ExitButton" Type="PushButton" X="280" Y="140" Width="75" Height="25"
                 Text="退出" Default="yes" Cancel="yes">
          <Publish Event="EndDialog" Value="Exit" Condition="1" />
        </Control>
      </Dialog>
    </UI>
    <InstallUISequence>
      <Show Dialog="RuntimeMissingDlg" Sequence="1250"
            Condition="NOT DOTNET10_PRESENT = &quot;0&quot; AND NOT REMOVE" />
    </InstallUISequence>

    <!-- 安装目录：Program Files\LabelFrame（64 位） -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="LabelFrame" />
    </StandardDirectory>

    <!-- 开始菜单 -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="LabelFrame">
        <Component Id="StartMenuShortcut">
          <Shortcut Id="StartMenuShortcut" Name="LabelFrame"
                    Description="启动 LabelFrame 并打开浏览器编辑模板"
                    Target="[#WinHostExe]"
                    WorkingDirectory="INSTALLFOLDER" />
          <RemoveFolder Id="ApplicationProgramsRemove" Directory="ApplicationProgramsFolder" On="uninstall" />
          <RegistryValue Root="HKCU" Key="Software\LabelFrame" Name="startmenu" Type="integer" Value="1" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <!-- 桌面快捷方式 -->
    <StandardDirectory Id="DesktopFolder">
      <Component Id="DesktopShortcut">
        <Shortcut Id="DesktopShortcut" Name="LabelFrame"
                  Description="启动 LabelFrame 并打开浏览器编辑模板"
                  Target="[#WinHostExe]"
                  WorkingDirectory="INSTALLFOLDER" />
        <RemoveFolder Id="DesktopRemove" Directory="DesktopFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\LabelFrame" Name="desktop" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <Feature Id="MainFeature" Title="LabelFrame" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentGroupRef Id="WebFiles" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />
    </Feature>
  </Package>
</Wix>